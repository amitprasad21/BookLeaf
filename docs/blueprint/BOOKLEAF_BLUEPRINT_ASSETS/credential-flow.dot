digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.35", splines=ortho, fontname="Arial", label="JUST-IN-TIME CREDENTIAL ASSISTANCE", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555", fontname="Arial", fontsize=10, margin="0.14,0.08"];
  edge [color="#555555", arrowsize=0.7, fontname="Arial", fontsize=9];
  a [label="Agent reaches a task that truly needs a credential"];
  b [shape=diamond, label="Can work continue safely without it?", fillcolor="#eeeeee"];
  c [label="Continue scaffold/manual fallback; record blocker"];
  d [label="Pause at the exact dependency; explain why and choices"];
  e [label="Guide user to official provider setup, step by step"];
  f [label="User creates secret in provider console"];
  g [label="User places it in local env or hosting secret settings"];
  h [label="Add variable name only to .env.example; verify .gitignore"];
  i [label="Run a safe presence/connection test; never print secret"];
  j [label="Resume blocked task; update credential guide and handover"];
  a -> b;
  b -> c [label="Yes"];
  b -> d [label="No"];
  d -> e -> f -> g -> h -> i -> j;
}
