# BookLeaf: environment variable reference (names and placeholders ONLY)
#
# Never put real values in this file. Each runtime reads its own local file:
#   backend/.env                 -> section 1 (server-only secrets live here)
#   author-frontend/.env.local   -> section 2 (browser-exposed values only)
#   admin-frontend/.env.local    -> section 2 (browser-exposed values only)
# Deployed environments set the same names in the hosting provider's secret
# settings (Render for the backend, Vercel for the two frontends).
# Setup steps for each value: .agent/CREDENTIALS_GUIDE.md

# ---------------------------------------------------------------------------
# 1. BACKEND (backend/.env): SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of exact frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase project URL and publishable key. The backend uses these to build
# request-scoped clients that carry the caller's JWT, so RLS still applies.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Privileged key: BYPASSES RLS. Used only by the narrow system writer
# (AI results, audit events) and the seed script. Server-only.
SUPABASE_SECRET_KEY=replace-with-secret-key

# AI runtime (D-028). Provider values: gemini | groq | mock | none
# "none" = manual mode (no AI calls); "mock" = deterministic local stub
# (development and tests only; production refuses it).
# Models default per provider: gemini = gemini-3.5-flash-lite (triage) and
# gemini-3.8-flash (drafts); groq = openai/gpt-oss-120b. Override with
# AI_PRIMARY_MODEL (both tasks) and AI_PRIMARY_DRAFT_MODEL.
AI_PRIMARY_PROVIDER=mock
AI_PRIMARY_MODEL=
AI_PRIMARY_DRAFT_MODEL=

# Optional fallback: a DIFFERENT provider with its own key (C-14). Leave
# AI_FALLBACK_PROVIDER empty to disable. Never add a second key for the
# same provider to get around its limits.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_DRAFT_MODEL=

# Provider keys: server-only, needed only for the providers configured above.
GEMINI_API_KEY=replace-with-gemini-key
GROQ_API_KEY=replace-with-groq-key

# Cost and resilience controls
AI_DAILY_TOKEN_BUDGET=300000
AI_TRIAGE_TIMEOUT_MS=15000
AI_DRAFT_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000

# Seed script only (run locally; never needed by the running server)
SEED_AUTHOR_PASSWORD=replace-with-demo-author-password
SEED_ADMIN_PASSWORD=replace-with-demo-admin-password

# ---------------------------------------------------------------------------
# 2. FRONTENDS (author-frontend/.env.local and admin-frontend/.env.local)
#    PUBLIC: shipped to the browser. Never put secret or LLM keys here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
